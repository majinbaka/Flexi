# Copy this file to .env and adjust values for your local environment.
# Root .env is consumed by docker-compose.yml and by the frontend's VITE_*
# variables below. It is NOT read by the backend: @nestjs/config and the
# Prisma CLI resolve `.env` relative to process.cwd(), which is
# apps/backend/ when scripts run via `pnpm --filter backend ...`. The
# backend needs its own apps/backend/.env -- copy apps/backend/.env.example
# there (see README step 2). The values below are mirrored here only for
# reference/consistency with the docker-compose service definitions.

# --- Backend (reference only -- see apps/backend/.env.example, the file the backend actually reads) ---
NODE_ENV=development
PORT=3000

# Postgres connection string used by Prisma. Matches the docker-compose service below.
DATABASE_URL="postgresql://flexi:flexi@localhost:5432/flexi?schema=public"

# Redis connection string, provisioned by docker-compose (not yet consumed by any module).
REDIS_URL="redis://localhost:6379"

# --- Backend, continued (reference only -- see apps/backend/.env.example for full documentation) ---
# CORS_ORIGIN=
# AUTH_THROTTLE_TTL=60
# AUTH_THROTTLE_LIMIT=5
# TRUST_PROXY_HOPS=1

# Setup-invite email. SMTP is disabled explicitly for local development, so
# the backend can start without a mail provider. Production enables SMTP by
# default; either configure every SMTP_* value through your secret manager or
# set SMTP_ENABLED=false deliberately when invitation delivery is not needed.
SMTP_ENABLED=false
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USERNAME="smtp-user"
# SMTP_PASSWORD="replace-with-a-secret-manager-value"
# SMTP_FROM="no-reply@example.com"
# SMTP_SECURE=false
# SMTP_TIMEOUT_MS=10000

# Public frontend origin used to construct one-time account setup links.
# Use the externally reachable HTTPS origin in deployed environments; omit a
# trailing slash. This is not the API URL and must not contain a token.
SETUP_ACCOUNT_URL_BASE="http://localhost:5173"

# --- Docker Compose (Postgres) ---
POSTGRES_USER=flexi
POSTGRES_PASSWORD=flexi
POSTGRES_DB=flexi
POSTGRES_PORT=5432

# --- Docker Compose (Redis) ---
REDIS_PORT=6379

# --- Frontend (Vite; must be prefixed VITE_ to be exposed to client code) ---
VITE_API_BASE_URL="http://localhost:3000/api"
