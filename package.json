{
  "name": "flexi",
  "private": true,
  "version": "0.1.0",
  "description": "Flexi low-code platform monorepo",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "scripts": {
    "dev:backend": "pnpm --filter @flexi/backend start:dev",
    "dev:frontend": "pnpm --filter @flexi/frontend dev",
    "build": "pnpm --filter @flexi/shared-types build && pnpm --filter @flexi/backend build && pnpm --filter @flexi/frontend build",
    "build:shared-types": "pnpm --filter @flexi/shared-types build",
    "build:backend": "pnpm --filter @flexi/backend build",
    "build:frontend": "pnpm --filter @flexi/frontend build",
    "lint": "pnpm -r --if-present run lint",
    "prisma:generate": "pnpm --filter @flexi/backend prisma:generate",
    "prisma:migrate": "pnpm --filter @flexi/backend prisma:migrate"
  }
}
