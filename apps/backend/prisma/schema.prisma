// Flexi core metadata schema.
//
// Multi-tenancy strategy: row-level `tenantId` column on every tenant-scoped
// table (NOT schema-per-tenant). See Design Notes in
// _bmad-output/implementation-artifacts/spec-flexi-core-scaffold.md for the
// rationale. `Permission` and `Translation` are global (not tenant-scoped);
// every other model below carries a `tenantId` foreign key.
//
// This schema models core *metadata* only. `DynamicTable` / `DynamicField`
// describe the shape of user-created tables -- they do NOT create the actual
// dynamic tables. That requires a runtime DDL engine (raw SQL / Knex),
// which is deferred (see deferred-work.md, module #2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & Identity
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantUsers   TenantUser[]
  roles         Role[]
  dynamicTables DynamicTable[]
  dynamicFields DynamicField[]
  workflows     Workflow[]
  pages         Page[]
  cronJobs      CronJob[]
  mailTemplates MailTemplate[]
  wikiPages     WikiPage[]
  logEntries    LogEntry[]

  @@map("tenants")
}

// Login identity only -- email + passwordHash. Deliberately holds NO
// DB-unique constraint on `email`: the same address may back independent
// AuthAccount rows in different tenants, or as a SystemUser alongside a
// separate TenantUser identity, each a fully separate account with its own
// password. Per-scope disambiguation (no two TenantUsers in the same tenant
// share an email; no two SystemUsers share an email) is enforced at the
// service layer on account creation -- see spec-core-authentication.md
// Design Notes for the rationale.
//
// An AuthAccount backs at most one actor overall (SystemUser XOR
// TenantUser, never both); this is also service-layer-enforced only (no DB
// unique constraint on authAccountId on either side) so it can be relaxed
// later without an ERD migration.
model AuthAccount {
  id           String   @id @default(cuid())
  email        String
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  systemUsers   SystemUser[]
  tenantUsers   TenantUser[]
  refreshTokens RefreshToken[]

  @@index([email])
  @@map("auth_accounts")
}

// Platform-level actor (e.g. Super Admin) -- not scoped to any tenant.
// Authorized through the exact same PermissionsGuard / Role->Permission
// mechanism as TenantUser; there is no isSuperAdmin-style bypass.
model SystemUser {
  id            String   @id @default(cuid())
  authAccountId String
  name          String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  authAccount AuthAccount @relation(fields: [authAccountId], references: [id], onDelete: Cascade)
  roles       Role[]      @relation("SystemUserRoles")

  @@index([authAccountId])
  @@map("system_users")
}

// Tenant-scoped actor -- replaces the prior flat `User` model. Both "Admin"
// and regular "User" are TenantUser rows, differing only by the Role
// assigned to them.
model TenantUser {
  id            String   @id @default(cuid())
  tenantId      String
  authAccountId String
  name          String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authAccount AuthAccount @relation(fields: [authAccountId], references: [id], onDelete: Cascade)
  roles       Role[]      @relation("TenantUserRoles")

  @@index([tenantId])
  @@index([authAccountId])
  @@map("tenant_users")
}

// tenantId is nullable: null marks a system-level role (assignable only to
// a SystemUser), a set value marks a tenant-scoped role (assignable only to
// TenantUsers of that tenant). Mirrors the nullable-tenantId pattern already
// used on LogEntry for system-level rows.
model Role {
  id          String   @id @default(cuid())
  tenantId    String?
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantUsers     TenantUser[]     @relation("TenantUserRoles")
  systemUsers     SystemUser[]     @relation("SystemUserRoles")
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

// Global catalog of permission codes (e.g. "users.create"). Not tenant-scoped
// -- every tenant's roles are granted a subset of this shared catalog.
//
// `scope` is a plain string (not a Prisma enum) validated against the
// PermissionScope enum exported from @flexi/shared-types -- kept as a string
// so the allowed set stays defined in exactly one place, shared by both
// apps, matching the convention already used by DynamicField.dataType and
// LogEntry.level. A Role with a set tenantId (a tenant role) can never hold
// a SYSTEM-scope permission -- enforced wherever a RolePermission link is
// created (today: only the seed script).
model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  scope       String   @default("TENANT")
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Rotating refresh tokens, keyed on authAccountId (not on the actor table --
// an AuthAccount is the login identity, so its refresh tokens are actor-type
// agnostic). Stored only as a SHA-256 hash; the raw token is returned to the
// client once (login/refresh response) and never persisted in plaintext.
// Using a token rotates it: the row is marked revokedAt and a new row is
// issued; replaying a revoked/expired/unknown token fails 401.
model RefreshToken {
  id            String    @id @default(cuid())
  authAccountId String
  tokenHash     String    @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  authAccount AuthAccount @relation(fields: [authAccountId], references: [id], onDelete: Cascade)

  @@index([authAccountId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Dynamic Table / Field Builder (metadata / definitions only)
// ---------------------------------------------------------------------------

model DynamicTable {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fields DynamicField[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("dynamic_tables")
}

// dataType is a plain string validated against the FieldDataType enum
// exported from @flexi/shared-types -- kept as a string (not a Prisma enum)
// so the allowed set stays defined in exactly one place, shared by both apps.
model DynamicField {
  id        String   @id @default(cuid())
  tenantId  String
  tableId   String
  name      String
  slug      String
  dataType  String
  required  Boolean  @default(false)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  table  DynamicTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, slug])
  @@index([tenantId])
  @@index([tableId])
  @@map("dynamic_fields")
}

// ---------------------------------------------------------------------------
// Workflows / Pages / Cron / Mail / Wiki (metadata / definitions only)
// ---------------------------------------------------------------------------

model Workflow {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  status      String   @default("draft")
  definition  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("workflows")
}

model Page {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  path       String
  status     String   @default("draft")
  definition Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, path])
  @@index([tenantId])
  @@map("pages")
}

model CronJob {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  schedule  String
  targetRef String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("cron_jobs")
}

model MailTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  subject   String
  body      String
  variables Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("mail_templates")
}

model WikiPage {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  slug      String
  content   String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent WikiPage?  @relation("WikiPageHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children WikiPage[] @relation("WikiPageHierarchy")

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("wiki_pages")
}

// ---------------------------------------------------------------------------
// Platform-level: logging & translations
// ---------------------------------------------------------------------------

// tenantId is nullable because system-level log entries (startup, cron
// engine, etc.) are not attributable to a single tenant.
model LogEntry {
  id        String   @id @default(cuid())
  tenantId  String?
  level     String   @default("INFO")
  message   String
  context   Json?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([createdAt])
  @@map("log_entries")
}

// Base system-UI translations (en/vi stubs). Per-tenant / dynamic-content
// i18n (field labels, page names, wiki content) is deferred -- see
// deferred-work.md. Deliberately global (no tenantId).
model Translation {
  id        String   @id @default(cuid())
  locale    String
  namespace String   @default("common")
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, namespace, key])
  @@map("translations")
}
