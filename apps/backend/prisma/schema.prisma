// Flexi public identity and control-plane schema.
//
// Prisma owns platform-wide data: tenants, login identities, role and
// permission assignments, onboarding/audit records, and feature definitions.
// A `tenantId` here expresses ownership or routing for control-plane records;
// it is not the storage boundary for tenant runtime data.
//
// Runtime dynamic data lives in a Postgres schema named `tenant_<tenantId>`.
// Tenant provisioning creates and bootstraps that schema; Dynamic Tables uses
// schema-qualified Knex queries/DDL there for `_meta_*` metadata and
// user-created tables. See `resolve-tenant-schema.ts`,
// `tenant-knex.service.ts`, and `dynamic-tables.service.ts`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy & Identity
// ---------------------------------------------------------------------------

model Tenant {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  status              String   @default("ACTIVE")
  // Seat quota. `-1` means unlimited and is the default, so an already
  // provisioned tenant keeps behaving exactly as it did before quotas
  // existed. See UserQuotaService for what consumes a seat.
  maxUsers            Int      @default(-1)
  onboardingAttemptId String?  @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  onboardingAttempt TenantOnboardingAttempt? @relation(fields: [onboardingAttemptId], references: [id], onDelete: SetNull)
  tenantUsers       TenantUser[]
  settings          TenantSettings?
  userInvites       UserInvite[]
  roles             Role[]
  dynamicTables     DynamicTable[]
  dynamicFields     DynamicField[]
  workflows         Workflow[]
  pages             Page[]
  cronJobs          CronJob[]
  mailTemplates     MailTemplate[]
  wikiPages         WikiPage[]
  logEntries        LogEntry[]
  setupTokens       SetupToken[]
  impersonationSessions ImpersonationSession[]

  @@index([status])
  @@map("tenants")
}

// Login identity only -- email + passwordHash. Deliberately holds NO
// DB-unique constraint on `email`: the same address may back independent
// AuthAccount rows in different tenants, or as a SystemUser alongside a
// separate TenantUser identity, each a fully separate account with its own
// password. Per-scope disambiguation (no two TenantUsers in the same tenant
// share an email; no two SystemUsers share an email) is enforced at the
// service layer on account creation -- see spec-core-authentication.md
// Design Notes for the rationale.
//
// An AuthAccount backs at most one actor overall (SystemUser XOR
// TenantUser, never both); this is also service-layer-enforced only (no DB
// unique constraint on authAccountId on either side) so it can be relaxed
// later without an ERD migration.
model AuthAccount {
  id                 String   @id @default(cuid())
  email              String
  passwordHash       String
  isActive           Boolean  @default(true)
  // Raised by an admin force-reset (and by nothing else). While true the
  // holder can still authenticate -- so they can reach the change-password
  // endpoint at all -- but every access token issued to them carries the
  // flag, and the frontend routes them into the change-password flow until
  // they set a password of their own, which clears it.
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  systemUsers       SystemUser[]
  tenantUsers       TenantUser[]
  refreshTokens     RefreshToken[]
  passwordResetOtps PasswordResetOtp[]

  @@index([email])
  @@map("auth_accounts")
}

// Emailed six-digit password-reset code. Hash-only at rest like
// RefreshToken and SetupToken: the raw digits exist in memory only long
// enough to be handed to the mail transport, and are never persisted,
// logged or returned by an API.
//
// The hash is bcrypt, not the SHA-256 those two use. They hold 256-bit
// random tokens, where a fast hash is fine because the preimage space is
// unsearchable; a six-digit code has about twenty bits of entropy, so a
// SHA-256 of it falls to an exhaustive sweep of all 10^6 candidates in
// milliseconds if this table ever leaks.
//
// `attemptCount` is what makes brute-forcing a six-digit code impractical
// without a blacklist or a Redis counter: after
// PASSWORD_RESET_OTP_MAX_ATTEMPTS wrong submissions the row is consumed
// outright, so the remaining ~10^6 guesses cost a fresh email (itself
// behind a 60-second per-account cooldown and an IP throttle) every three
// tries.
//
// Rows are never deleted -- a consumed row is the record that a reset
// happened -- so lookups always filter on `consumedAt: null`.
model PasswordResetOtp {
  id            String    @id @default(cuid())
  authAccountId String
  otpHash       String
  expiresAt     DateTime
  consumedAt    DateTime?
  attemptCount  Int       @default(0)
  createdAt     DateTime  @default(now())

  authAccount AuthAccount @relation(fields: [authAccountId], references: [id], onDelete: Cascade)

  // Covers the only two hot reads: "does this account have a live code?"
  // (cooldown check + verification) and "burn every outstanding code".
  @@index([authAccountId, consumedAt])
  @@map("password_reset_otps")
}

// Append-only audit trail for password recovery, session revocation and
// account lifecycle changes. Deliberately relation-free -- like
// TenantOnboardingAuditLog -- so a row survives the deletion of the account
// it describes; `subjectAuthAccountId`/`actorAuthAccountId` are plain ids,
// not foreign keys.
//
// `metadata` holds non-secret context only (reason codes, counts, the
// requesting IP). An OTP, a temporary password, a token or a password hash
// must never reach this table.
model AuthAuditLog {
  id                   String   @id @default(cuid())
  event                String
  tenantId             String?
  // The account the event happened *to*.
  subjectAuthAccountId String?
  // The account that caused it, when that is somebody else (an admin
  // force-reset or deactivation). Null for self-service actions.
  actorAuthAccountId   String?
  // True for events performed through a delegated tenant identity. The
  // SystemUser id stays separate so auditors can distinguish the real
  // person from the TenantUser whose permissions were used.
  impersonated         Boolean  @default(false)
  impersonatorId       String?
  metadata             Json?
  createdAt            DateTime @default(now())

  @@index([event])
  @@index([subjectAuthAccountId])
  @@index([tenantId])
  @@index([createdAt])
  @@index([impersonated, impersonatorId])
  @@map("auth_audit_logs")
}

// A server-side revocation handle for a short-lived impersonation access
// token. The ids intentionally have no foreign keys: audit/revocation
// evidence must survive actor deletion, while a deleted tenant makes the
// token fail JwtAuthGuard's ACTIVE tenant check anyway.
model ImpersonationSession {
  id                   String   @id @default(cuid())
  tenantId             String
  targetAuthAccountId  String
  targetTenantUserId   String
  impersonatorId       String
  expiresAt            DateTime
  endedAt              DateTime?
  createdAt            DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([targetTenantUserId, endedAt])
  @@index([impersonatorId, endedAt])
  @@index([expiresAt])
  @@map("impersonation_sessions")
}

// Platform-level actor (e.g. Super Admin) -- not scoped to any tenant.
// Authorized through the exact same PermissionsGuard / Role->Permission
// mechanism as TenantUser; there is no isSuperAdmin-style bypass.
model SystemUser {
  id            String   @id @default(cuid())
  authAccountId String
  name          String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  authAccount              AuthAccount               @relation(fields: [authAccountId], references: [id], onDelete: Cascade)
  roles                    Role[]                    @relation("SystemUserRoles")
  tenantOnboardingAttempts TenantOnboardingAttempt[]

  @@index([authAccountId])
  @@map("system_users")
}

model TenantOnboardingAttempt {
  id                  String   @id @default(uuid())
  actorSystemUserId   String?
  status              String   @default("accepted")
  provisioningJobId   String?  @unique
  safePayload         Json
  actorIdentity       Json
  requestIdentity     Json
  idempotencyKey      String   @unique
  idempotencyIdentity Json
  stepOutcomes        Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  actorSystemUser SystemUser? @relation(fields: [actorSystemUserId], references: [id], onDelete: SetNull)
  tenant          Tenant?

  @@index([actorSystemUserId])
  @@index([status])
  @@index([createdAt])
  @@map("tenant_onboarding_attempts")
}

// Permanent, append-only audit evidence for one onboarding attempt's
// activation outcome (Story 2.6). Mirrors LogEntry's field-typing
// conventions (Json fields, @@index, @@map) but is a sibling of
// TenantOnboardingAttempt for its id strategy -- `uuid()`, not `cuid()` --
// since it shares the same attempt-identity space (`attemptId` is unique,
// one row per attempt). Never updated or deleted after insert; the
// `audit_finalized` step upserts on `attemptId` only to stay idempotent
// against a full-job BullMQ retry re-entering an already-finalized attempt
// -- the row's terminal content is unchanged by that upsert once the
// attempt is truly final (see provisioning.service.ts's finalizeAudit()).
model TenantOnboardingAuditLog {
  id              String   @id @default(uuid())
  attemptId       String   @unique
  tenantId        String?
  actorIdentity   Json
  requestIdentity Json
  safePayload     Json
  stepOutcomes    Json
  compensation    Json?
  finalStatus     String
  createdAt       DateTime @default(now())

  @@index([tenantId])
  @@index([finalStatus])
  @@map("tenant_onboarding_audit_logs")
}

// Tenant-scoped actor -- replaces the prior flat `User` model. Both "Admin"
// and regular "User" are TenantUser rows, differing only by the Role
// assigned to them.
//
// `status` is a plain string validated at the service layer against the
// TenantUserStatus enum in @flexi/shared-types (the same convention as
// `Permission.scope` and `DynamicField.dataType`). It records where in the
// lifecycle a membership is; `isActive` records whether it may
// authenticate, and AuthService reads only the latter. The two must move
// together on any transition into `locked` or `deleted`.
//
// A `deleted` row is kept, never removed: it is the record that somebody
// was once a member, and the email it holds must stay visible to the
// uniqueness check for as long as an administrator might restore it. It
// does not occupy a seat.
model TenantUser {
  id            String   @id @default(cuid())
  tenantId      String
  authAccountId String
  name          String?
  status        String   @default("active")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authAccount AuthAccount  @relation(fields: [authAccountId], references: [id], onDelete: Cascade)
  roles       Role[]       @relation("TenantUserRoles")
  invites     UserInvite[]

  // One membership per login identity per tenant. Already true in
  // practice -- an AuthAccount backs at most one actor overall -- but
  // stated here so a future direct-create or invite path cannot silently
  // produce a second membership row that would double-count a seat.
  @@unique([tenantId, authAccountId])
  @@index([tenantId])
  @@index([authAccountId])
  @@map("tenant_users")
}

// Per-tenant self-registration policy. Deliberately a small table owned by
// the Users module rather than a row in a generic settings catalog: the
// configuration engine (issue #48) does not exist yet, and these four
// fields are read on the hot path of every registration attempt, where a
// typed column beats a JSON lookup. When that engine lands, this table is
// what migrates into it.
model TenantSettings {
  id                    String   @id @default(cuid())
  tenantId              String   @unique
  allowSelfRegistration Boolean  @default(false)
  // Support access is off unless a tenant explicitly opts in. This is kept
  // beside the other tenant-owned identity controls rather than becoming a
  // control-plane bypass.
  allowSystemImpersonation Boolean @default(false)
  // Bare domains, lowercased and without the "@" (e.g. "acme.com"). An
  // empty list with self-registration enabled means "any domain"; the
  // whitelist only narrows.
  allowedEmailDomains   String[] @default([])
  // Role granted to a self-registered user. Nullable because a tenant can
  // enable self-registration before deciding on a role, in which case
  // registration is refused rather than silently granting nothing.
  defaultRoleId         String?
  // Whether a self-registered user lands in `pending_approval` (true) or
  // straight in `active` (false). Defaults to true: the safe direction is
  // the one where a stranger cannot reach tenant data unreviewed.
  requireApproval       Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultRole Role?  @relation("TenantSettingsDefaultRole", fields: [defaultRoleId], references: [id], onDelete: SetNull)

  @@index([defaultRoleId])
  @@map("tenant_settings")
}

// One emailed invitation to join a tenant.
//
// Hash-only at rest, exactly like SetupToken and RefreshToken: the raw
// token is returned once from the service that mints it, handed to the
// mail transport, and never persisted, logged or returned again. Redeeming
// looks the row up by the hash of the presented token.
//
// The invited TenantUser row is created up front (in `pending_invite`), so
// an outstanding invite occupies a seat and a redemption is a status
// change rather than a creation that could fail on a quota that filled up
// in the meantime.
//
// `status` is validated at the service layer against the UserInviteStatus
// enum in @flexi/shared-types. Expiry is not one of its transitions: a
// `pending` row past `expiresAt` is already expired everywhere it matters
// (redemption refuses it, the seat count excludes it), which is why no
// sweeper job is needed to keep the column honest.
model UserInvite {
  id           String    @id @default(cuid())
  tenantId     String
  // Copied from the AuthAccount at invite time so a listing does not have
  // to join through the account, and so the address that was actually
  // invited stays on the record even if the account's email later changes.
  email        String
  roleId       String?
  tenantUserId String?
  tokenHash    String    @unique
  expiresAt    DateTime
  status       String    @default("pending")
  usedAt       DateTime?
  revokedAt    DateTime?
  // The TenantUser who sent it. Nullable and FK-free on purpose: an invite
  // outlives the administrator who issued it.
  invitedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       Role?       @relation("UserInviteRole", fields: [roleId], references: [id], onDelete: SetNull)
  tenantUser TenantUser? @relation(fields: [tenantUserId], references: [id], onDelete: SetNull)

  // Covers the seat count ("live invites of this tenant") and the tenant's
  // invite listing; the unique token hash covers redemption on its own.
  @@index([tenantId, status, expiresAt])
  @@index([tenantId, email])
  @@index([roleId])
  @@index([tenantUserId])
  @@map("user_invites")
}

// tenantId is nullable: null marks a system-level role (assignable only to
// a SystemUser), a set value marks a tenant-scoped role (assignable only to
// TenantUsers of that tenant). Mirrors the nullable-tenantId pattern already
// used on LogEntry for system-level rows.
model Role {
  id          String   @id @default(cuid())
  tenantId    String?
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantUsers     TenantUser[]     @relation("TenantUserRoles")
  systemUsers     SystemUser[]     @relation("SystemUserRoles")
  rolePermissions RolePermission[]
  tenantSettings  TenantSettings[] @relation("TenantSettingsDefaultRole")
  userInvites     UserInvite[]     @relation("UserInviteRole")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

// Global catalog of permission codes (e.g. "users.create"). Not tenant-scoped
// -- every tenant's roles are granted a subset of this shared catalog.
//
// `scope` is a plain string (not a Prisma enum) validated against the
// PermissionScope enum exported from @flexi/shared-types -- kept as a string
// so the allowed set stays defined in exactly one place, shared by both
// apps, matching the convention already used by DynamicField.dataType and
// LogEntry.level. A Role with a set tenantId (a tenant role) can never hold
// a SYSTEM-scope permission -- enforced wherever a RolePermission link is
// created (today: only the seed script).
model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  scope       String   @default("TENANT")
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Rotating refresh tokens, keyed on authAccountId (not on the actor table --
// an AuthAccount is the login identity, so its refresh tokens are actor-type
// agnostic). Stored only as a SHA-256 hash; the raw token is returned to the
// client once (login/refresh response) and never persisted in plaintext.
// Using a token rotates it: the row is marked revokedAt and a new row is
// issued; replaying a revoked/expired/unknown token fails 401.
model RefreshToken {
  id            String    @id @default(cuid())
  authAccountId String
  tokenHash     String    @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  authAccount AuthAccount @relation(fields: [authAccountId], references: [id], onDelete: Cascade)

  @@index([authAccountId])
  @@map("refresh_tokens")
}

// One-time, short-lived setup secret for a tenant's First Admin to claim
// their pending_setup TenantUser (Story 2.5). Mirrors RefreshToken's
// hash-only-at-rest shape/pattern exactly: the raw token is returned to the
// caller once (SetupLinkService.generate()'s return value) and never
// persisted in plaintext -- only its SHA-256 hash is stored. Every call to
// SetupLinkService.generate() (automatic provisioning step or manual
// regeneration) revokes every still-unconsumed SetupToken for the tenant
// first, then mints a fresh one. A successful redemption sets `usedAt`, so a
// token cannot be replayed even if it has not separately been revoked.
model SetupToken {
  id        String    @id @default(cuid())
  tenantId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // The unique token hash covers redemption lookup. This composite index
  // keeps tenant-wide revocation/regeneration efficient while excluding
  // consumed tokens from the active-token scan.
  @@index([tenantId, revokedAt, usedAt])
  @@map("setup_tokens")
}

// ---------------------------------------------------------------------------
// Dynamic Table / Field Builder (public control-plane definitions)
// ---------------------------------------------------------------------------

// These Prisma models do not represent the live runtime metadata or
// user-created tables. Those are created and queried in each tenant schema by
// DynamicTablesService; these declarations remain public-plane definitions.

model DynamicTable {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fields DynamicField[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("dynamic_tables")
}

// dataType is a plain string validated against the FieldDataType enum
// exported from @flexi/shared-types -- kept as a string (not a Prisma enum)
// so the allowed set stays defined in exactly one place, shared by both apps.
model DynamicField {
  id        String   @id @default(cuid())
  tenantId  String
  tableId   String
  name      String
  slug      String
  dataType  String
  required  Boolean  @default(false)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  table  DynamicTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, slug])
  @@index([tenantId])
  @@index([tableId])
  @@map("dynamic_fields")
}

// ---------------------------------------------------------------------------
// Workflows / Pages / Cron / Mail / Wiki (metadata / definitions only)
// ---------------------------------------------------------------------------

model Workflow {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  status      String   @default("draft")
  definition  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("workflows")
}

model Page {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  path       String
  status     String   @default("draft")
  definition Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, path])
  @@index([tenantId])
  @@map("pages")
}

model CronJob {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  schedule  String
  targetRef String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("cron_jobs")
}

model MailTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  subject   String
  body      String
  variables Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("mail_templates")
}

model WikiPage {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  slug      String
  content   String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   WikiPage?  @relation("WikiPageHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children WikiPage[] @relation("WikiPageHierarchy")

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("wiki_pages")
}

// ---------------------------------------------------------------------------
// Platform-level: logging & translations
// ---------------------------------------------------------------------------

// tenantId is nullable because system-level log entries (startup, cron
// engine, etc.) are not attributable to a single tenant.
model LogEntry {
  id        String   @id @default(cuid())
  tenantId  String?
  level     String   @default("INFO")
  message   String
  context   Json?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([createdAt])
  @@map("log_entries")
}

// Base system-UI translations (en/vi stubs). Per-tenant / dynamic-content
// i18n (field labels, page names, wiki content) is deferred -- see
// deferred-work.md. Deliberately global (no tenantId).
model Translation {
  id        String   @id @default(cuid())
  locale    String
  namespace String   @default("common")
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, namespace, key])
  @@map("translations")
}
