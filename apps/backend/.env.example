# Copy to apps/backend/.env -- this is what @nestjs/config and the Prisma CLI
# actually read at runtime (both use process.cwd(), which is apps/backend
# when scripts run via `pnpm --filter @flexi/backend ...`).
# Values should match the root .env.example / docker-compose.yml.

NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://flexi:flexi@localhost:5432/flexi?schema=public"
REDIS_URL="redis://localhost:6379"

# Secrets used to sign JWT access/refresh tokens (apps/backend/src/modules/auth).
# Required -- generate real random values per environment, never reuse these.
JWT_ACCESS_SECRET="dev-access-secret-change-me-please-32chars"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-please-32chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Comma-separated list of allowed CORS origins (e.g.
# "https://app.example.com,https://admin.example.com"). Leave unset only for
# local dev, where CORS stays fully permissive -- see main.ts. Production
# requires this allowlist; use public HTTP(S) origins only (no paths).
# CORS_ORIGIN=

# Rate limiting for POST /api/auth/login and /api/auth/refresh (seconds / max
# attempts per window). Defaults shown are applied automatically if unset.
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=5

# Dynamic Tables guardrails. These finite defaults cap tenant-schema growth,
# mutation request work, and catalog/row page sizes. Override per deployment
# without introducing plan-specific entitlements.
DYNAMIC_TABLES_MAX_TABLES_PER_TENANT=50
DYNAMIC_TABLES_MAX_FIELDS_PER_TABLE=100
DYNAMIC_TABLES_MAX_MUTATION_PAYLOAD_BYTES=65536
DYNAMIC_TABLES_MAX_PAGE_SIZE=100

# Bound for the in-memory validation-schema LRU cache (per backend instance,
# keyed by dynamic table id). Caps the cache's footprint on a long-running
# multi-tenant instance, where a dropped table or tenant leaves no
# invalidation hook behind. Raising it trades memory for fewer _meta_fields
# reads after an eviction.
DYNAMIC_TABLES_VALIDATION_SCHEMA_CACHE_MAX_ENTRIES=500

# Number of hops to trust for X-Forwarded-For when this app sits behind a
# reverse proxy/load balancer. Leave unset (disabled) unless a real proxy
# fronts this deployment -- trusting hops with no real proxy lets a client
# spoof its own X-Forwarded-For to bypass rate limiting. Conversely, if a
# real proxy IS in front and this is left unset, rate limiting collapses
# into one shared bucket for all clients (every request appears to come
# from the proxy's own IP) -- set this whenever a proxy/load balancer is
# added.
# TRUST_PROXY_HOPS=1

# Setup-invite email. SMTP is disabled explicitly for local development, so
# the backend can start without a mail provider. Production requires SMTP and
# every SMTP_* value through your secret manager.
SMTP_ENABLED=false
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USERNAME="smtp-user"
# SMTP_PASSWORD="replace-with-a-secret-manager-value"
# SMTP_FROM="no-reply@example.com"
# SMTP_SECURE=false
# SMTP_TIMEOUT_MS=10000

# Public frontend origin used to construct one-time account setup links.
# Use the externally reachable HTTPS origin in deployed environments. It must
# also appear in CORS_ORIGIN; this is not the API URL and must not contain a token.
SETUP_ACCOUNT_URL_BASE="http://localhost:5173"
