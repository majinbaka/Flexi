{
  "name": "@flexi/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Flexi core platform - React/Vite frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
